{
    "version": 3,
    "configurePresets": [
        {
            "name": "debug",
            "description": "Native debug build (no sanitizers, so it can run under valgrind)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" }
    ]
}
