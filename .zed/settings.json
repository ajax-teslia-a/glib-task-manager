{
    "tab_size": 4,
    "hard_tabs": false,
    "preferred_line_length": 140,
    "soft_wrap": "none",
    "format_on_save": "on",
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "languages": {
        "C": {
            "tab_size": 4,
            "hard_tabs": false,
            "formatter": "language_server",
            "format_on_save": "on",
            "wrap_guides": [140]
        }
    },
    "lsp": {
        "clangd": {
            "binary": {
                "arguments": [
                    "--background-index",
                    "--clang-tidy",
                    "--header-insertion=never",
                    "--completion-style=detailed",
                    "--query-driver=/usr/bin/gcc,/usr/bin/cc",
                    "--compile-commands-dir=build/debug"
                ]
            }
        }
    }
}
